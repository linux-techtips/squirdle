{
  "name": "squirdle-impl",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun run --hot src",
    "bundle": "NODE_ENV=production bun build src --env inline --target bun --outdir out --production --minify",
    "bundle:clean": "bun clean && bun bundle",
    "serve": "NODE_ENV=production bun run --cwd out src",
    "clean": "rm -fr out",
    "db:init": "bun run scripts/init.script",
    "db:clean": "rm squirdle.db*",
    "db:upload": "sqlite3 squirdle.db \"VACUUM INTO 'upload.db'\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react-scan": "^0.5.6"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
